{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kollegen Client",
  "version": "1.9.10",
  "identifier": "dev.kollegen.client",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "resizable": true,
        "title": "Kollegen Client",
        "width": 1400,
        "height": 850,
        "minWidth": 860,
        "minHeight": 600,
        "decorations": true,
        "center": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": {
        "default-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost"
        ],
        "connect-src": [
          "'self'",
          "https://*.minecraft.net",
          "https://login.microsoftonline.com",
          "https://user.auth.xboxlive.com",
          "https://xsts.auth.xboxlive.com",
          "https://api.minecraftservices.com",
          "https://api.modrinth.com",
          "https://api.curseforge.com",
          "https://launchermeta.mojang.com",
          "https://sessionserver.mojang.com",
          "https://api.boatswain.dev"
        ],
        "img-src": [
          "'self'",
          "https://*.modrinth.com",
          "https://cdn.modrinth.com",
          "https://*.minecraft.net",
          "https://textures.minecraft.net",
          "https://crafatar.com",
          "https://media.forgecdn.net",
          "https://mc-heads.net",
          "data:"
        ],
        "style-src": [
          "'self'",
          "'unsafe-inline'"
        ],
        "script-src": [
          "'self'",
          "'unsafe-inline'"
        ],
        "frame-src": [
          "'self'",
          "https://www.youtube.com"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/"
    ],
    "targets": [
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2MTM0OEZCMTkyNzg2MzUKUldRMWhpY1orMGdUVmpYOVREUGtzZXpBb241dWQzWW9HWjBsOWg5U3BHZTdJUUUzL0NEUWdLUnIK",
      "endpoints": [
        "https://github.com/FluffyBento/KollegenClient/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}