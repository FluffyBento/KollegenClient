# Kollegen backend - example environment variables
# Copy this file to /etc/default/kollegen or export the vars in your service unit
# DO NOT commit real secrets into version control.

# Port to listen on
PORT=8080

# Data directory for store.json
KOLLEGEN_DATA_DIR=/var/lib/kollegenclient/data

# Presence TTL in milliseconds (how long a presence is considered valid)
PRESENCE_TTL_MS=90000

# If you run behind HTTPS-terminating reverse proxy (recommended), set this
REQUIRE_HTTPS_NOTE=1

# Optional: presence backend token (if you decide to require one). Do NOT
# place secrets into the repo; set them on the server via environment or
# systemd unit files.
# KOLLEGEN_PRESENCE_TOKEN=

# Run: node index.js
# Example systemd unit can read this file (EnvironmentFile=/etc/default/kollegen)
